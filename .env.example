# Copy to .env and fill in the values. (.env is not tracked by git)
# Public Data Portal university department information API key (api.odcloud.kr)
DATA_GO_API_KEY=
# Amazon Bedrock model ID or inference profile ID for the AI timetable maker. Unset = AI timetable maker answers 503.
BEDROCK_MODEL_ID=
# Bedrock API key. If unset, credentials come from the EC2 instance role (or ~/.aws / AWS_* env vars locally).
AWS_BEARER_TOKEN_BEDROCK=
# Optional: Bedrock region (default ap-northeast-2)
# AWS_REGION=
# CareerNet (career.go.kr) Open API key for job descriptions. Without it, jobs show names only.
CAREERNET_API_KEY=
